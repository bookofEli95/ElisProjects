             /****************************************************************/
             /* P1CCANCL2                                                    */
             /* PCR: Batch Close/Cancel PCRs - CL driver                     */
             /****************************************************************/
             /* ************************************************************ */
             /* Program Information                                          */
             /* ------------------------------------------------------------ */
             /* Loads a CSV of Item#/Job# pairs into PCRCANSTG, then runs    */
             /* P1VCANCL2 to close each one via the same P1VCANCL worker the */
             /* F8 Close/Cancel PCR screen uses. Review PCRCANRSLT afterward */
             /* for the outcome of every row (CLOSED/SKIPPED/ERROR).         */
             /* ************************************************************ */
             /* ************************************************************ */
             /* Program History                                              */
             /* ------------------------------------------------------------ */
             /* Project   Date     Int Description                           */
             /* ------- -------- --- --------------------------------------- */
             /* H33975  09/25/26 EFI Parameterize for portal upload screen   */
             /* ************************************************************ */
             PGM        PARM(&IFSPATH)

             DCL        VAR(&IFSPATH) TYPE(*CHAR) LEN(256)
             DCL        VAR(&PATHT)   TYPE(*CHAR) LEN(256)

             /* Build the IFS path */
             CHGVAR     VAR(&PATHT) VALUE(%TRIM(&IFSPATH))

             /* 1. Wipe the staging and results tables clean */
             CLRPFM     FILE(OBJECT/PCRCANSTG)
             CLRPFM     FILE(OBJECT/PCRCANRSLT)

             /* 2. Upload the CSV into the staging table */
             CPYFRMIMPF FROMSTMF(&PATHT) TOFILE(OBJECT/PCRCANSTG) +
                          MBROPT(*ADD) RCDDLM(*CRLF) STRDLM(*DBLQUOTE) +
                          FLDDLM(',') RPLNULLVAL(*FLDDFT) ERRLVL(*NOMAX)

             /* 3. Call the RPGLE batch processing program */
             CALL       PGM(OBJECT/P1VCANCL2)

             /* 4. Clean up staging table */
             CLRPFM     FILE(OBJECT/PCRCANSTG)

             ENDPGM
